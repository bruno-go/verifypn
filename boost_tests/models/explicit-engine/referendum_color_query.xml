  <property>
    <id>Selected voter reaches voting</id>
    <description>Selected voter reaches voting</description>
    <formula>
      <exists-path>
        <finally>
          <integer-eq>
            <tokens-count>
              <place>Referendum_colored_voting<color-expression><color id="Voters1"/></color-expression></place>
            </tokens-count>
